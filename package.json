{
  "name": "sunny-court-manager",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=24.14.0 <25",
    "pnpm": ">=11.7.0 <12"
  },
  "scripts": {
    "build": "pnpm typecheck && pnpm --filter @sunny-court/web build && pnpm --filter @sunny-court/sim-cli build",
    "boundaries": "node scripts/check-boundaries.mjs",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm boundaries && pnpm test && pnpm build",
    "dev:web": "pnpm --filter @sunny-court/web dev",
    "evidence:manifest": "node scripts/generate-evidence-manifest.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "sim:batch": "pnpm --filter @sunny-court/sim-cli build && node apps/sim-cli/dist/cli.js batch",
    "sim:three-years": "pnpm --filter @sunny-court/sim-cli build && node apps/sim-cli/dist/cli.js run",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.1.2",
    "eslint": "10.8.0",
    "fake-indexeddb": "6.2.5",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vitest": "4.1.10"
  }
}
